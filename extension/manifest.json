{
  "manifest_version": 3,
  "name": "calm-yt",
  "version": "1.0.0",
  "description": "A calmer YouTube experience, controlled locally.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*"
  ],
  "action": {
    "default_title": "calm-yt",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["youtube.css"],
      "js": ["settings.js", "content.js"]
    }
  ]
}
